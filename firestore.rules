rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Story Validation Helper
    function isValidStory(data) {
      return data.id is string && isValidId(data.id)
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 200
        && data.content is string && data.content.size() >= 10 && data.content.size() <= 50000
        && data.author is string && data.author.size() <= 100
        && data.authorId is string && data.authorId == request.auth.uid
        && data.category is string && data.category.size() <= 50
        && (!('authorEmail' in data) || (data.authorEmail is string && data.authorEmail.size() <= 128))
        && (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 500))
        && (!('image' in data) || (data.image is string && data.image.size() <= 500))
        && (!('imageCaption' in data) || (data.imageCaption is string && data.imageCaption.size() <= 200))
        && (!('likes' in data) || (data.likes is number && data.likes >= 0))
        && (!('views' in data) || (data.views is number && data.views >= 0));
    }

    // User Profile Validation Helper
    function isValidUserProfile(data, userId) {
      return data.id is string && data.id == userId
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && (!('role' in data) || (data.role is string && data.role.size() <= 150))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 2000))
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500))
        && (!('handle' in data) || (data.handle is string && data.handle.size() <= 50))
        && (!('location' in data) || (data.location is string && data.location.size() <= 100))
        && (!('website' in data) || (data.website is string && data.website.size() <= 300));
    }

    // Comment Validation Helper
    function isValidComment(data, storyId) {
      return data.id is string && isValidId(data.id)
        && data.storyId is string && data.storyId == storyId
        && data.author is string && data.author.size() <= 100
        && data.authorId is string && data.authorId == request.auth.uid
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 2000
        && (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 500));
    }

    // Stories Collection
    match /stories/{storyId} {
      // Anyone can read published stories
      allow get, list: if true;

      // Authenticated users can create stories if valid and own ID is set
      allow create: if isSignedIn()
        && isValidId(storyId)
        && isValidStory(incoming())
        && incoming().id == storyId;

      // Author can update their story or anyone can increment claps/views
      allow update: if isValidId(storyId) && (
        (isOwner(existing().authorId) && isValidStory(incoming()) && incoming().authorId == existing().authorId)
        || (incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'views']))
      );

      // Only author can delete their story
      allow delete: if isValidId(storyId) && isOwner(existing().authorId);

      // Story Comments Subcollection
      match /comments/{commentId} {
        allow get, list: if true;

        allow create: if isSignedIn()
          && isValidId(commentId)
          && isValidComment(incoming(), storyId)
          && incoming().id == commentId;

        allow update: if isValidId(commentId)
          && isOwner(existing().authorId)
          && isValidComment(incoming(), storyId);

        allow delete: if isValidId(commentId)
          && (isOwner(existing().authorId) || isOwner(get(/databases/$(database)/documents/stories/$(storyId)).data.authorId));
      }
    }

    // User Profiles Collection
    match /users/{userId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId);

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId);

      allow delete: if isValidId(userId) && isOwner(userId);
    }
  }
}
